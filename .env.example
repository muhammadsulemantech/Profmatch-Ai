# ==========================================
# PROFMATCH AI — ENVIRONMENT CONFIGURATION
# ==========================================

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# SUPABASE CONFIGURATION (Database & Auth & Storage)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------
# AI PROVIDER CONFIGURATION
# ------------------------------------------
# Supported providers: 'openai' | 'anthropic' | 'gemini' | 'mock'
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemini-1.5-pro

# ------------------------------------------
# SEARCH & ACADEMIC DATA PROVIDER CONFIGURATION
# ------------------------------------------
# Supported providers: 'serpapi' | 'tavily' | 'openalex' | 'mock'
SEARCH_PROVIDER=mock
SEARCH_API_KEY=your-search-api-key-here
ACADEMIC_DATA_PROVIDER=mock

# ------------------------------------------
# EMAIL PROVIDER CONFIGURATION
# ------------------------------------------
# Supported providers: 'resend' | 'smtp' | 'mock'
EMAIL_PROVIDER=mock
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="ProfMatch AI Outreach <outreach@yourdomain.com>"
EMAIL_REPLY_TO="support@yourdomain.com"

# ------------------------------------------
# PAYMENT & BILLING (STRIPE)
# ------------------------------------------
# Supported providers: 'stripe' | 'mock'
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_STUDENT_PRICE_ID=price_student_monthly
STRIPE_PRO_PRICE_ID=price_pro_monthly

# ------------------------------------------
# OAUTH AUTHENTICATION (Optional Google OAuth)
# ------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------
# SECURITY & SYSTEM SETTINGS
# ------------------------------------------
ADMIN_SECRET_PASSPHRASE=super-secure-admin-passphrase-change-in-prod
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=60
